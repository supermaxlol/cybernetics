import FiveOrgans.DiffContrast

/-!
# Random visit counts: removing the fixed-`N` caveat

In a Markov chain, the successors of state `x` can be generated from an independent table
`Z x 0, Z x 1, …` (the random-table representation): the chain reads the next unused entry of the
current state's row. The counts `N x` are then random and can depend on the table in any way.
`DiffContrast.diff_tail` treats them as fixed. This module removes that caveat by a union bound
over every count the sample allows, so **no assumption about how the counts arise is needed**,
only that they lie in a known finite set (for a sample of `T` steps, `1 ≤ N ≤ T`).

* `random_index_le` — for any events `bad q` and any random index `I ω ∈ S`,
  `P(ω ∈ bad (I ω)) ≤ Σ_{q ∈ S} P(bad q)`.
* `interleave_inj` — the two successor tables sit in one independent family `Z` at even
  (state 1) and odd (state 2) positions; for fixed counts, the reindexing used by `diff_tail` is
  injective, so independence is kept (`iIndepFun.precomp`).
* `random_diff` — **difference test with random counts:** for any radius function `t n₁ n₂ ≥ 0`
  and any random counts `N₁ ω, N₂ ω ∈ S` (positive),
  `P(t (N₁, N₂) ≤ |D̂ − (p₁ − p₂)|) ≤ Σ_{n₁,n₂ ∈ S} 2 exp(−2 t(n₁,n₂)² / (1/n₁ + 1/n₂))`.
* `random_diff_alpha` — with `S = {1,…,T}` and `t(n₁,n₂)² = (1/n₁ + 1/n₂) log(2T²/α) / 2`,
  the error probability is at most `α`. The price for random counts is replacing `log(2/α)` by
  `log(2T²/α)` in the radius.

What is still assumed: that the data are generated by such a table (equivalent in law to a
time-homogeneous Markov chain at the order used; see `MarkovOrderK` for order).
-/

namespace FiveOrgans.RandomCount
open MeasureTheory ProbabilityTheory Finset Real FiveOrgans.DiffContrast

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]

/-- **Random index.** -/
theorem random_index_le {ι : Type*} (bad : ι → Set Ω) (S : Finset ι) (I : Ω → ι)
    (hI : ∀ ω, I ω ∈ S) :
    μ.real {ω | ω ∈ bad (I ω)} ≤ ∑ q ∈ S, μ.real (bad q) := by
  have hsub : {ω | ω ∈ bad (I ω)} ⊆ ⋃ q ∈ S, bad q := by
    intro ω hω
    exact Set.mem_biUnion (hI ω) hω
  exact (measureReal_mono hsub (measure_ne_top _ _)).trans (measureReal_biUnion_finset_le S bad)

/-- Position of entry `i` in the combined family: first `n₁` from the even table, then the odd. -/
def interleave (n₁ i : ℕ) : ℕ := if i < n₁ then 2 * i else 2 * (i - n₁) + 1

theorem interleave_inj (n₁ : ℕ) : Function.Injective (interleave n₁) := by
  intro i j h
  unfold interleave at h
  split_ifs at h <;> omega

/-- The empirical difference with counts `n₁, n₂`: even table vs odd table. -/
noncomputable def Dhat (Z : ℕ → Ω → ℝ) (n₁ n₂ : ℕ) (ω : Ω) : ℝ :=
  (1 / n₁) * ∑ i ∈ range n₁, Z (2 * i) ω - (1 / n₂) * ∑ i ∈ range n₂, Z (2 * i + 1) ω

/-- **Difference test with random counts.** -/
theorem random_diff {Z : ℕ → Ω → ℝ} (hZ : ∀ i, Measurable (Z i)) (hind : iIndepFun Z μ)
    (h01 : ∀ i ω, Z i ω ∈ Set.Icc (0 : ℝ) 1) {p₁ p₂ : ℝ}
    (hm1 : ∀ i, μ[Z (2 * i)] = p₁) (hm2 : ∀ i, μ[Z (2 * i + 1)] = p₂)
    (S : Finset ℕ) (hS : ∀ n ∈ S, 0 < n) (N₁ N₂ : Ω → ℕ) (hN₁ : ∀ ω, N₁ ω ∈ S)
    (hN₂ : ∀ ω, N₂ ω ∈ S) (t : ℕ → ℕ → ℝ) (ht : ∀ a b, 0 ≤ t a b) :
    μ.real {ω | t (N₁ ω) (N₂ ω) ≤ |Dhat Z (N₁ ω) (N₂ ω) ω - (p₁ - p₂)|}
      ≤ ∑ q ∈ S ×ˢ S, 2 * exp (-(2 * t q.1 q.2 ^ 2) / (1 / (q.1 : ℝ) + 1 / q.2)) := by
  let bad : ℕ × ℕ → Set Ω := fun q => {ω | t q.1 q.2 ≤ |Dhat Z q.1 q.2 ω - (p₁ - p₂)|}
  have h := random_index_le (μ := μ) bad (S ×ˢ S) (fun ω => (N₁ ω, N₂ ω))
    (fun ω => mem_product.2 ⟨hN₁ ω, hN₂ ω⟩)
  refine h.trans (sum_le_sum fun q hq => ?_)
  obtain ⟨hq1, hq2⟩ := mem_product.1 hq
  let W : ℕ → Ω → ℝ := fun i => Z (interleave q.1 i)
  have hW1 : ∀ i < q.1, W i = Z (2 * i) := fun i hi => by simp [W, interleave, hi]
  have hW2 : ∀ i, W (q.1 + i) = Z (2 * i + 1) := fun i => by
    simp [W, interleave]
  have key := diff_tail (μ := μ) (W := W) (fun i => hZ _) (hind.precomp (interleave_inj q.1))
    (fun i ω => h01 _ ω) (hS _ hq1) (hS _ hq2) (p₁ := p₁) (p₂ := p₂)
    (fun i hi => by rw [hW1 i hi]; exact hm1 i) (fun i => by rw [hW2 i]; exact hm2 i)
    (ht q.1 q.2)
  convert key using 4 with ω
  simp only [Dhat]
  rw [sum_congr rfl fun i hi => (congrFun (hW1 i (mem_range.1 hi)) ω).symm,
    sum_congr rfl fun i _ => (congrFun (hW2 i) ω).symm]

/-- **Calibrated radius for random counts:** total error `≤ α` over a sample of `T` steps. -/
theorem random_diff_alpha {Z : ℕ → Ω → ℝ} (hZ : ∀ i, Measurable (Z i)) (hind : iIndepFun Z μ)
    (h01 : ∀ i ω, Z i ω ∈ Set.Icc (0 : ℝ) 1) {p₁ p₂ : ℝ}
    (hm1 : ∀ i, μ[Z (2 * i)] = p₁) (hm2 : ∀ i, μ[Z (2 * i + 1)] = p₂)
    {T : ℕ} (hT : 0 < T) {α : ℝ} (hα : 0 < α) (hα1 : α ≤ 1) (N₁ N₂ : Ω → ℕ)
    (hN₁ : ∀ ω, N₁ ω ∈ Icc 1 T) (hN₂ : ∀ ω, N₂ ω ∈ Icc 1 T) :
    μ.real {ω | √((1 / (N₁ ω : ℝ) + 1 / N₂ ω) * log (2 / (α / T ^ 2)) / 2)
        ≤ |Dhat Z (N₁ ω) (N₂ ω) ω - (p₁ - p₂)|} ≤ α := by
  have hS : ∀ n ∈ Icc 1 T, 0 < n := fun n hn => by have := (mem_Icc.1 hn).1; omega
  have h := random_diff hZ hind h01 hm1 hm2 (Icc 1 T) hS N₁ N₂ hN₁ hN₂
    (fun a b => √((1 / (a : ℝ) + 1 / b) * log (2 / (α / T ^ 2)) / 2)) (fun _ _ => sqrt_nonneg _)
  have hTpos : (0 : ℝ) < T := by exact_mod_cast hT
  have ha : 0 < α / T ^ 2 := by positivity
  have hlog : 0 ≤ log (2 / (α / T ^ 2)) := by
    have hT1 : (1 : ℝ) ≤ T := by exact_mod_cast hT
    have : α / T ^ 2 ≤ 1 := (div_le_self hα.le (one_le_pow₀ hT1)).trans hα1
    apply log_nonneg; rw [le_div_iff₀ ha]; linarith
  have hterm : ∀ q ∈ Icc 1 T ×ˢ Icc 1 T,
      2 * exp (-(2 * √((1 / (q.1 : ℝ) + 1 / q.2) * log (2 / (α / T ^ 2)) / 2) ^ 2)
        / (1 / (q.1 : ℝ) + 1 / q.2)) = α / T ^ 2 := by
    intro q hq
    obtain ⟨h1, h2⟩ := mem_product.1 hq
    have c1 : (0 : ℝ) < q.1 := by exact_mod_cast hS _ h1
    have c2 : (0 : ℝ) < q.2 := by exact_mod_cast hS _ h2
    have hs : 0 < 1 / (q.1 : ℝ) + 1 / q.2 := add_pos (one_div_pos.2 c1) (one_div_pos.2 c2)
    exact diff_t_solves hs ha (by rw [sq_sqrt (div_nonneg (mul_nonneg hs.le hlog) zero_le_two)])
  refine h.trans (le_of_eq ?_)
  rw [sum_congr rfl hterm, sum_const, card_product, Nat.card_Icc, nsmul_eq_mul]
  simp only [Nat.add_sub_cancel]
  push_cast
  field_simp

end FiveOrgans.RandomCount
